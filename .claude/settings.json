{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(gh issue view *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(.vonagerc)",
      "Read(*.key)"
    ]
  }
}
