root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# palantir-java-format, applied by Spotless
[*.java]
indent_size = 4

# Generated by Spring Initializr with tabs
[pom.xml]
indent_style = tab

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
