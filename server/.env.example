# Copy this file to .env and fill in your own values. Never commit .env.
# Setup steps: docs/setup.md
DB_URL=your_database_url
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
LOAD_DEMO_DATA=true_or_false
SESSION_COOKIE_SECURE=true_or_false
API_DOCS_ENABLED=true_or_false

# Vonage: one group per API, with the application of the person who builds it
# Private keys go in base64 on a single line, as explained in docs/setup.md
VONAGE_VERIFY_APPLICATION_ID=your_verify_application_id
VONAGE_VERIFY_PRIVATE_KEY=your_verify_private_key_in_base64
VONAGE_VIDEO_APPLICATION_ID=your_video_application_id
VONAGE_VIDEO_PRIVATE_KEY=your_video_private_key_in_base64
VONAGE_MESSAGES_APPLICATION_ID=your_messages_application_id
VONAGE_MESSAGES_PRIVATE_KEY=your_messages_private_key_in_base64
VONAGE_MESSAGES_SIGNATURE_SECRET=your_messages_signature_secret

# Post-visit call: off by default, so the server starts without these lines.
# To try it, uncomment them and fill them in as explained in docs/setup.md
# VOICE_CALLS_ENABLED=true
# POST_VISIT_CALL_DELAY_MINUTES=15
# SERVER_PUBLIC_URL=your_public_https_url
# VONAGE_VOICE_APPLICATION_ID=your_voice_application_id
# VONAGE_VOICE_PRIVATE_KEY=your_voice_private_key_in_base64
# VONAGE_VOICE_FROM_NUMBER=your_vonage_number_without_plus
# VONAGE_VOICE_SIGNATURE_SECRET=your_voice_signature_secret

# Hashes phone numbers in phone verification. Never paste it into an AI assistant
PHONE_HASH_SECRET=your_phone_hash_secret
