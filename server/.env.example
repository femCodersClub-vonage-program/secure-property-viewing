# Copy this file to .env and fill in your own values. Never commit .env.
# Setup steps: docs/setup.md
DB_URL=your_database_url
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
LOAD_DEMO_DATA=true_or_false
SESSION_COOKIE_SECURE=true_or_false
API_DOCS_ENABLED=true_or_false
# Vonage Verify: phone verification. Never paste these values into an AI assistant
VONAGE_VERIFY_APPLICATION_ID=your_verify_application_id
VONAGE_VERIFY_PRIVATE_KEY=your_verify_private_key_in_base64
PHONE_HASH_SECRET=a_long_random_secret
