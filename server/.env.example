# Copy this file to .env and fill in your own values. Never commit .env.
# Setup steps: docs/setup.md
DB_URL=your_database_url
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
LOAD_DEMO_DATA=true_or_false

# Vonage: one group per API, with the application of the person who builds it
# Private keys go in base64 on a single line, as explained in docs/setup.md
VONAGE_VERIFY_APPLICATION_ID=your_verify_application_id
VONAGE_VERIFY_PRIVATE_KEY=your_verify_private_key_in_base64
VONAGE_VIDEO_APPLICATION_ID=your_video_application_id
VONAGE_VIDEO_PRIVATE_KEY=your_video_private_key_in_base64
VONAGE_MESSAGES_APPLICATION_ID=your_messages_application_id
VONAGE_MESSAGES_PRIVATE_KEY=your_messages_private_key_in_base64
VONAGE_MESSAGES_SIGNATURE_SECRET=your_messages_signature_secret
